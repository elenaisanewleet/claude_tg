# --- обязательное ------------------------------------------------------------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Твой Telegram user_id — единственный, кто может открывать доступ другим.
# Узнать: напиши /id этому боту (команда работает даже без доступа) или @userinfobot
OWNER_USER_ID=

# --- доступ ------------------------------------------------------------------
# Кого пускать сразу, без запроса (через запятую). Владелец добавляется сам.
ALLOWED_USER_IDS=

# --- где хранить данные ------------------------------------------------------
# По умолчанию ~/.claude-tg
# DATA_DIR=/var/lib/claude-tg
# WORKSPACE_ROOT=/var/lib/claude-tg/workspaces
# DB_PATH=/var/lib/claude-tg/claude-tg.sqlite3

# --- Claude ------------------------------------------------------------------
# Авторизация на сервере без браузера. На своём компьютере выполни
#   claude setup-token
# и вставь сюда полученный sk-ant-oat01-… (это ключ к твоей подписке — храни как пароль).
# Локально, где уже сделан `claude auth login`, переменная не нужна.
# CLAUDE_CODE_OAUTH_TOKEN=

# Если платишь по токенам через Anthropic API, а не подпиской — вместо токена выше:
# ANTHROPIC_API_KEY=

# Путь до CLI, если он не в PATH (например /opt/homebrew/bin/claude)
# CLAUDE_CLI_PATH=

# Алиасы всегда указывают на свежую версию: opus | sonnet | fable | haiku
DEFAULT_MODEL=opus
# low | medium | high | xhigh | max
DEFAULT_EFFORT=high
# default | acceptEdits | plan | dontAsk | auto | bypassPermissions
DEFAULT_PERMISSION_MODE=default
# adaptive | summarized | disabled
DEFAULT_THINKING=adaptive

# --- как показывать ответы ---------------------------------------------------
SHOW_THINKING=true
SHOW_TOOLS=true
SHOW_FOOTER=true
STREAM_INTERVAL=1.4
MESSAGE_LIMIT=3500

# --- лимиты расхода на человека ----------------------------------------------
# Потолок для тех, кому открыт доступ, в долларах по публичному прайсу.
# Подписка так не тарифицируется — это мера «кто сколько съел».
# Владелец по умолчанию без ограничений; менять — командой /limit в чате.
DEFAULT_BUDGET_USD=5
# Скользящее окно, часов. 168 = неделя, как у недельного окна подписки.
BUDGET_WINDOW_HOURS=168

# --- лимиты ------------------------------------------------------------------
# Telegram отдаёт ботам файлы не больше 20 МБ
MAX_DOWNLOAD_MB=20
# Сколько ждать ответа на запрос разрешения, секунд
PERMISSION_TIMEOUT=300
# Потолок на один ход, секунд
TURN_TIMEOUT=3600

# --- поддержание актуальности ------------------------------------------------
AUTO_UPDATE=true
AUTO_UPDATE_HOUR=5

LOG_LEVEL=INFO
